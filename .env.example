# ─── MongoDB ──────────────────────────────────────────────────────────────────
# REQUIRED. MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED. Secret used to sign session JWTs (7 d) and password-reset tokens (1 h).
# Refresh tokens are opaque 64-byte random hex strings whose SHA-256 hash is
# stored in MongoDB; they do not use a JWT secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-random-jwt-secret-key

# ─── Hostinger / Stackmail SMTP ───────────────────────────────────────────────
# REQUIRED. Outbound email for booking confirmations, password resets, etc.
STACKMAIL_HOST=smtp.hostinger.com
STACKMAIL_PORT=587
STACKMAIL_SECURE=false
STACKMAIL_USER=support@globalintegratedsupport.com
STACKMAIL_PASS=your-smtp-password

# ─── Admin notification email ─────────────────────────────────────────────────
# Optional. Where admin booking/inquiry notifications are sent.
# Falls back to STACKMAIL_USER if not set.
ADMIN_EMAIL=support@globalintegratedsupport.com

# ─── API & Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Trust Proxy ──────────────────────────────────────────────────────────────
# Optional. Express trust-proxy value for correct client IP behind Vercel/Nginx/Docker.
# 1 = single hop (recommended for Vercel); true = trust all; false = disabled.
TRUST_PROXY=1

# ─── Frontend URL(s) for CORS ─────────────────────────────────────────────────
# Optional. Comma-separated origin allowlist added on top of hardcoded production domains.
# IMPORTANT: must include EVERY production origin you serve:
#   - Apex domain:          https://globalintegratedsupport.com
#   - WWW domain:           https://www.globalintegratedsupport.com
#   - Admin subdomain:      https://admin.globalintegratedsupport.com (if any)
#   - Preview/staging URLs
FRONTEND_URL=https://globalintegratedsupport.com,https://www.globalintegratedsupport.com

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
# REQUIRED. Used by POST /api/upload (admin blog images).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Facebook Graph API (optional — reviews sync feature) ─────────────────────
# If either FB_PAGE_ID or FB_ACCESS_TOKEN is absent the sync endpoint returns 400.
FB_PAGE_ID=
FB_ACCESS_TOKEN=

# ─── Cron secret (optional) ───────────────────────────────────────────────────
# If set, the /api/cron/sync-facebook endpoint accepts Bearer <CRON_SECRET>
# without requiring an admin JWT (useful for Vercel Cron / external schedulers).
CRON_SECRET=

# ─── Structured logging ───────────────────────────────────────────────────────
# Optional. pino log level: trace | debug | info | warn | error | fatal
# Defaults to "info". Use "debug" in development, "warn" in production.
LOG_LEVEL=info

# ─── Sentry (optional — error tracking) ──────────────────────────────────────
# If absent, Sentry is completely disabled (no imports, no network traffic).
# Get your DSN from https://sentry.io → Project Settings → SDK Setup.
SENTRY_DSN=
# Sampling rate for Sentry traces performance monitoring (0.0 to 1.0). Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Business timezone ────────────────────────────────────────────────────────
# REQUIRED in production (NODE_ENV=production). In development/test, defaults to America/New_York.
# IANA timezone string, e.g. America/New_York, Europe/London, Asia/Karachi
BUSINESS_TIMEZONE=America/New_York

# ─── Redis (optional — distributed rate limiting) ─────────────────────────────
# When set, rate limiters use Redis (rate-limit-redis) for shared state across instances.
# When unset, in-memory rate limiting is used (note: in-memory is per-instance on Vercel/serverless).
# Example: redis://default:<password>@<host>:<port> or rediss:// for TLS
REDIS_URL=

# ─── Web Auth Cookie Domain (optional) ────────────────────────────────────────
# Domain for httpOnly refresh cookie. Recommended when API is served on a subdomain
# (e.g. .globalintegratedsupport.com so cookie is shared between api and web).
COOKIE_DOMAIN=



# ─── Realtime / WebSockets ───────────────────────────────────────────────────
# Optional. Set to "true" to disable Socket.IO real-time server (useful for tests or workers)
DISABLE_REALTIME=false

# ─── Technician / Cron ────────────────────────────────────────────────────────
ENABLE_CRON=false
CRON_SECRET=your-cron-secret-here

# ─── Stripe Payments (optional) ────────────────────────────────────────────────
# Secret API key (starts with sk_test_ in development/test, sk_live_ in production)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_...
